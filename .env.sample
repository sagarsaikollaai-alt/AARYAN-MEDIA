# Copy this file to .env and adjust values for local development.
# Do NOT commit real secrets. Keep service-role keys on the server (Render).

# Frontend API base (used by Vite proxy and runtime fetches)
# VITE_API_URL=https://aaryan-media-course-backend.onrender.com

# Optional: uncomment to test against a local backend
VITE_API_URL=http://localhost:5000

# Example of other frontend-only envs you might use
# VITE_SUPABASE_URL=https://<your-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=anon_...
